# Variables serveur — ne jamais préfixer ces valeurs par VITE_
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role
BREVO_API_KEY=votre_cle_api_brevo
# Adresse centrale appartenant à la plateforme SaaS, jamais une adresse personnelle.
BREVO_SENDER_EMAIL=notifications@votre-domaine-saas.fr
BREVO_SENDER_NAME=Qualification Habilitations
PUBLIC_APP_URL=https://votre-application.vercel.app
RATE_LIMIT_SECRET=une_valeur_aleatoire_longue_et_unique
KEEPALIVE_TOKEN=une_autre_valeur_aleatoire_longue_et_unique

# Ces valeurs publiques servent uniquement à Supabase Auth dans le navigateur.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=votre_cle_publiable_supabase

# Réglages facultatifs
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15
VITE_DEFAULT_ORGANIZATION_SLUG=asfor
